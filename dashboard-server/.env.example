PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
ANALYST_USERNAME=analyst
ANALYST_PASSWORD_HASH=paste-a-bcrypt-hash-here
# Optional second dashboard user. Generate the hash with:
# node -e "console.log(require('bcryptjs').hashSync('replace-with-password', 12))"
ANALYST_USERNAME_2=security-operator
ANALYST_PASSWORD_HASH_2=paste-a-second-bcrypt-hash-here
FRONTEND_ORIGIN=http://localhost:5173

# Roles: admin or analyst (default analyst). Only admins can read the audit log.
ANALYST_ROLE=admin
ANALYST_ROLE_2=analyst
